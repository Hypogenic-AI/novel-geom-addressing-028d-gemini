{"type":"tool_use","timestamp":"2026-05-31T02:19:31.050Z","tool_name":"write_file","tool_id":"write_file__write_file_1780193971048_0","parameters":{"content":"import json\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\ndef analyze_results():\n    with open(\"results/exp1_results.json\", \"r\") as f:\n        exp1 = json.load(f)\n    with open(\"results/exp2_results.json\", \"r\") as f:\n        exp2 = json.load(f)\n        \n    df1 = pd.DataFrame(exp1)\n    df2 = pd.DataFrame(exp2)\n    \n    # Accuracy per N-shot\n    acc1 = df1.groupby('n_shots')['success'].mean()\n    acc2 = df2.groupby('n_shots')['success'].mean()\n    \n    print(\"Experiment 1 (Addressing) Accuracy:\")\n    print(acc1)\n    print(\"\\nExperiment 2 (Reasoning) Accuracy:\")\n    print(acc2)\n    \n    # Plotting\n    plt.figure(figsize=(10, 5))\n    \n    plt.subplot(1, 2, 1)\n    acc1.plot(kind='bar')\n    plt.title('Exp 1: Addressing Accuracy')\n    plt.xlabel('N Shots')\n    plt.ylabel('Accuracy')\n    \n    plt.subplot(1, 2, 2)\n    acc2.plot(kind='bar')\n    plt.title('Exp 2: Reasoning Accuracy')\n    plt.xlabel('N Shots')\n    plt.ylabel('Accuracy')\n    \n    plt.tight_layout()\n    plt.savefig('results/accuracy_plot.png')\n    \n    # Error Analysis Exp 1\n    failures = df1[df1['success'] == False]\n    print(\"\\nSample Failures (Exp 1):\")\n    for idx, row in failures.head(3).iterrows():\n        print(f\"N={row['n_shots']}, Target: {row['target_part']}, Expected: {row['target_coords'][:30]}..., Got: {row['response']}\")\n\nif __name__ == \"__main__\":\n    analyze_results()\n","file_path":"src/analyze_results.py"}}
